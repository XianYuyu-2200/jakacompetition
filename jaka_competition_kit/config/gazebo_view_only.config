<?xml version="1.0"?>
<!-- Workbench Gazebo layout: keep only the 3D viewport and its navigation. -->
<window>
  <position_x>-1</position_x>
  <position_y>-1</position_y>
  <state></state>
  <width>1200</width>
  <height>800</height>
  <style material_theme="Light" material_primary="#167969"
         material_accent="#03a9f4" toolbar_color_light="#f3f3f3"
         toolbar_text_color_light="#111111" toolbar_color_dark="#414141"
         toolbar_text_color_dark="#f3f3f3" />
  <!-- Do not show Gazebo's drawer / plugin toolbar; the workbench owns controls. -->
  <menus>
    <drawer visible="false" default="false" />
    <plugins visible="false" from_paths="false" />
  </menus>
  <dialog_on_exit>false</dialog_on_exit>
</window>

<!-- Main viewport. -->
<plugin filename="MinimalScene" name="3D View">
  <ignition-gui>
    <title>3D View</title>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </ignition-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.4 0.4 0.4</ambient_light>
  <background_color>0.8 0.8 0.8</background_color>
  <camera_pose>-6 0 6 0 0.5 0</camera_pose>
</plugin>

<!-- Keep scene rendering and mouse navigation, but make their panels invisible. -->
<plugin filename="GzSceneManager" name="Scene Manager">
  <ignition-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">1</property>
    <property key="height" type="double">1</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </ignition-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="Interactive view control">
  <ignition-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">1</property>
    <property key="height" type="double">1</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </ignition-gui>
</plugin>
<plugin filename="CameraTracking" name="Camera Tracking">
  <ignition-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">1</property>
    <property key="height" type="double">1</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </ignition-gui>
</plugin>
<plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
  <ignition-gui>
    <property key="resizable" type="bool">false</property>
    <property key="width" type="double">1</property>
    <property key="height" type="double">1</property>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
  </ignition-gui>
</plugin>
