<mujoco model="jaka_mini2">
  <!-- JAKA Mini 2 (minicobo) from the competition URDF.
       Six revolute joints, position actuators, JAKA wordmarks between joints 1-2, on the upper arm, between 4-5, and between 5-6.
       WHEELTEC MS42DC two-finger gripper on the flange (dummy_tcp == Link_6 origin, tool +Z). -->
  <compiler angle="radian" eulerseq="XYZ" meshdir="../../jaka_ros2/src/jaka_description/meshes/jaka_minicobo_meshes" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic"/>

  <visual>
    <headlight ambient="0.48 0.48 0.48" diffuse="0.45 0.45 0.45" specular="0.12 0.12 0.12"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="70" elevation="-18" offwidth="1600" offheight="1000"/>
    <quality shadowsize="4096"/>
    <map znear="0.01" zfar="30"/>
  </visual>

  <default>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" material="shell"/>
    </default>
    <default class="collision">
      <!-- Joint jogging should not be blocked by the floor or convex-hull self hits. -->
      <geom type="mesh" group="3" density="0" rgba="0.94 0.94 0.94 1" contype="0" conaffinity="0"/>
    </default>
    <default class="logo">
      <!-- Solid red wordmark mesh. Classic MuJoCo ignores PNG alpha, so letters are geometry. -->
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.80 0.12 0.15 1"/>
    </default>
    <default class="gripper">
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0"/>
    </default>
    <joint damping="3" armature="0.02" frictionloss="0.4"/>
    <position kp="180" kv="18" forcerange="-100 100"/>
  </default>

  <asset>
