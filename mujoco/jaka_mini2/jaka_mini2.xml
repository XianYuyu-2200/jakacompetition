    <material name="table_top" rgba="0.86 0.87 0.89 1" specular="0.12" shininess="0.25" reflectance="0.04"/>
    <material name="table_edge" rgba="0.62 0.64 0.68 1" specular="0.08" shininess="0.15"/>
