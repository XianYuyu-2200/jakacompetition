      <geom name="table_top" type="box" pos="0 0 -0.012" size="0.48 0.36 0.012" material="table_top" contype="1" conaffinity="1"/>
      <geom name="table_edge" type="box" pos="0 0 -0.026" size="0.492 0.372 0.004" material="table_edge" contype="0" conaffinity="0"/>
      <geom name="leg_fl" type="box" pos="-0.42 -0.30 -0.292" size="0.02 0.02 0.268" material="table_leg" contype="0" conaffinity="0"/>
