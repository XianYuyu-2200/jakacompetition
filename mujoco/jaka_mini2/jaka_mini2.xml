    <material name="mark_blue" rgba="0.22 0.48 0.95 1" specular="0.1" shininess="0.2"/>
    <mesh name="place_ring" file="/home/ktz/codex/codex-competition/mujoco/jaka_mini2/assets/place_ring.obj"/>
    <texture name="jaka_logo_tex" type="2d" file="assets/jaka_logo.png"/>
